# MythosAI local configuration
# Start the LM Studio local server before chatting.
# Leave MODEL_NAME blank to use the first model reported by /v1/models.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
MODEL_NAME=

# Generation settings
TEMPERATURE=0.7
MAX_TOKENS=2048
MAX_CHAT_MESSAGE_CHARS=12000

# Flask: leave empty to generate an ephemeral secret on each run.
# Set a persistent random secret if you add signed cookies or sessions later.
FLASK_SECRET_KEY=
DEBUG=False
PORT=5000

# Search: auto prefers SearXNG if SEARXNG_URL is set; otherwise uses
# DuckDuckGo Instant Answers, which is limited and is NOT a full web search API.
SEARCH_PROVIDER=auto
SEARXNG_URL=
SEARCH_TIMEOUT_SECONDS=8
SEARCH_MAX_RESULTS=10
